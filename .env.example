# Optional. Orchard does not load .env files automatically.
# Set these in your shell (e.g. `export ORCHARD_CONTACT_EMAIL=you@university.edu`), or pass --data-dir when starting.
ORCHARD_DATA_DIR=./data

# Your email address. Required by Unpaywall; also sent to OpenAlex, Crossref and NCBI so they can contact you.
ORCHARD_CONTACT_EMAIL=

# Optional keys. Every provider except CORE works without one.
ORCHARD_CORE_API_KEY=        # required to enable CORE: https://core.ac.uk/services/api
ORCHARD_OPENALEX_API_KEY=    # private daily budget; deep paging beyond 10,000 results
ORCHARD_S2_API_KEY=          # Semantic Scholar's keyless pool is frequently rate-limited
ORCHARD_NCBI_API_KEY=        # PubMed: 10 instead of 3 requests per second
